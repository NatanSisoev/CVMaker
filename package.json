{
  "name": "cvmaker",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend build pipeline for CVMaker (Tailwind + HTMX + Alpine). The Python side is uv-managed; this file owns CSS/JS only.",
  "scripts": {
    "dev": "concurrently -k -n css,js -c blue,green \"npm run dev:css\" \"npm run dev:js\"",
    "dev:css": "tailwindcss -i ./static/src/app.css -o ./static/dist/app.css --watch",
    "dev:js": "esbuild ./static/src/app.js --bundle --outfile=./static/dist/app.js --watch",
    "build:css": "cross-env NODE_ENV=production tailwindcss -i ./static/src/app.css -o ./static/dist/app.css --minify",
    "build:js": "cross-env NODE_ENV=production esbuild ./static/src/app.js --bundle --minify --outfile=./static/dist/app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.14.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "htmx.org": "^2.0.4",
    "tailwindcss": "^3.4.15"
  }
}
